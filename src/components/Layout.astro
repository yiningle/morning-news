---
import '../styles/paper.css';
import { FONT_PROBE_TIMEOUT_MS, FONT_SOURCES, FONT_SOURCE_TTL_MS } from '../font-sources';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fontConfig = { sources: FONT_SOURCES, timeoutMs: FONT_PROBE_TIMEOUT_MS, ttlMs: FONT_SOURCE_TTL_MS };
/* Replaced after the build by scripts/subset-fonts.mjs with this page's own font subset stylesheet. */
const SUBSET = '__FONT_SUBSET__';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e9e4d8" />
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />
    <meta name="font-subset" content={SUBSET} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    {/*
      Font source picker. Runs before any stylesheet and never blocks
      rendering: text shows at once in a metric-matched local fallback. Tries
      each CDN's CSS in order with a timeout, remembers the one that worked
      (localStorage, 7 days), and ends with this page's self-hosted subset.
      src/scripts/fonts.ts then downloads only the files the text needs and
      applies them between page turns. Same script on every page (the subset
      URL is read from the meta tag above), so a CSP could allow it by hash.
    */}
    <script is:inline define:vars={{ fontConfig }}>
      (function () {
        var cfg = fontConfig;
        var KEY = 'morning-news:font-source';
        var settle;
        var meta = document.querySelector('meta[name="font-subset"]');
        var subset = meta && meta.content && meta.content.indexOf('__') !== 0 ? meta.content : null;
        /* Read by src/scripts/fonts.ts, which downloads and applies the font files. */
        var state = (window.__fonts = { source: null, probeMs: null, cssAt: null, tried: [], css: null, subset: subset });
        state.ready = new Promise(function (resolve) { settle = resolve; });
        var at = function () { return Math.round(performance.now()); };
        var forced = null;
        try { forced = new URLSearchParams(location.search).get('fonts'); } catch (e) {}
        var stored = null;
        try {
          var saved = JSON.parse(localStorage.getItem(KEY) || 'null');
          if (saved && saved.exp > Date.now()) stored = saved.id;
        } catch (e) {}
        var list = cfg.sources.slice();
        if (forced) {
          list = list.filter(function (s) { return s.id === forced; });
        } else if (stored) {
          list.sort(function (a, b) { return (b.id === stored) - (a.id === stored); });
          state.stored = stored;
        }
        if (forced === 'self' || forced === 'none') list = [];
        if (subset) list.push({ id: 'self', css: [subset], preconnect: [] });
        if (forced === 'none') list = [];
        /* All CDNs together get at most two probe timeouts; then the self-hosted subset. */
        var deadline = performance.now() + cfg.timeoutMs * 2;

        function preconnect(source) {
          source.preconnect.forEach(function (origin) {
            var link = document.createElement('link');
            link.rel = 'preconnect';
            link.href = origin;
            link.crossOrigin = 'anonymous';
            document.head.appendChild(link);
          });
        }
        function remember(id) {
          if (forced) return;
          try {
            if (id) localStorage.setItem(KEY, JSON.stringify({ id: id, exp: Date.now() + cfg.ttlMs }));
            else localStorage.removeItem(KEY);
          } catch (e) {}
        }
        function finish(source, texts) {
          state.source = source ? source.id : 'system';
          state.cssAt = at();
          if (texts) state.css = texts.map(function (text, i) { return { text: text, base: new URL(source.css[i], location.href).href }; });
          document.documentElement.dataset.fonts = state.source;
          settle(state.source);
        }
        function probe(source, self) {
          return new Promise(function (resolve) {
            var controller = typeof AbortController === 'function' ? new AbortController() : null;
            var timer = setTimeout(function () {
              if (controller) controller.abort();
              resolve(null);
            }, self ? 10000 : Math.max(0, Math.min(cfg.timeoutMs, deadline - performance.now())));
            Promise.all(
              source.css.map(function (url) {
                return fetch(url, { mode: 'cors', credentials: 'omit', signal: controller ? controller.signal : undefined })
                  .then(function (response) { return response.ok ? response.text() : Promise.reject(); })
                  .then(function (text) { return text.indexOf('@font-face') >= 0 ? text : Promise.reject(); });
              }),
            ).then(
              function (texts) { clearTimeout(timer); resolve(texts); },
              function () { clearTimeout(timer); resolve(null); },
            );
          });
        }
        function next(i) {
          var source = list[i];
          if (!source || typeof fetch !== 'function') return finish(null, null);
          var self = source.id === 'self';
          if (!self && performance.now() >= deadline) return next(i + 1);
          var started = performance.now();
          if (!self) preconnect(source);
          probe(source, self).then(function (texts) {
            var ms = Math.round(performance.now() - started);
            state.tried.push(source.id + (texts ? ' ' : ' failed ') + ms + 'ms');
            if (!texts) {
              if (!self && stored === source.id) remember(null);
              return next(i + 1);
            }
            state.probeMs = ms;
            if (!self) remember(source.id);
            finish(source, texts);
          });
        }
        next(0);
      })();
    </script>
    <noscript><link rel="stylesheet" href={SUBSET} /></noscript>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { fontGate } from '../scripts/fonts';
      fontGate();
    </script>
  </body>
</html>
